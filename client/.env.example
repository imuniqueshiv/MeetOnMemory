# -----------------------------------------------------------------------------
# MEET ON MEMORY - CLIENT ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# Backend API Service Base URL
# Precedence Rule: The client config resolves VITE_BACKEND_URL first.
# If VITE_BACKEND_URL is missing, it falls back to VITE_API_URL.
# If both are omitted, it defaults to 'http://localhost:4000'.
VITE_BACKEND_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000

# Production example
# VITE_BACKEND_URL=https://meetonmemory.onrender.com
# VITE_API_URL=https://meetonmemory.onrender.com

# Required — Clerk publishable key (pk_test_… / pk_live_…)
VITE_CLERK_PUBLISHABLE_KEY=

# Issue #1335 — enable client-side transcript E2EE UI (AES-GCM via Web Crypto)
# Requires server E2EE_ENABLED=true as well.
VITE_E2EE_ENABLED=false
