PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/meetonmemory
# Redis — BullMQ queues, distributed rate limiting, and presence (e.g. redis://127.0.0.1:6379 or rediss://... in production)
REDIS_URI=redis://127.0.0.1:6379

# Clerk — sole identity provider
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=sk_test_replace_me

# Secondary JWT signing ONLY (Slack OAuth state, data exports).
# NOT used for user login sessions.
JWT_SECRET=replace_with_long_random_secret

# Dedicated JWT signing secret for shared-link access tokens
SHARED_LINK_JWT_SECRET=replace_with_shared_link_secret

NODE_ENV=development
# Production: set to your Vercel origin, e.g. https://meetonmemory.vercel.app
CLIENT_URL=http://localhost:5173
# Optional comma-separated extra SPA origins (preview deployments, etc.)
# ALLOWED_ORIGINS=https://meetonmemory.vercel.app,https://some-preview.vercel.app

# SMTP (product emails — not auth OTP)
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# AI / search / transcription (optional locally)
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
INDEX_NAME=
ASSEMBLYAI_API_KEY=
HUGGINGFACE_API_KEY=

# Calendar OAuth (Google/Microsoft product integrations — not Clerk login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/google/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:4000/api/calendar/outlook/callback
# Required to encrypt Google/Microsoft OAuth tokens and Slack integration tokens.
# No default — the process fails closed at boot if CALENDAR_ENCRYPTION_KEY or
# TOKEN_ENCRYPTION_KEY is unset in non-test environments.
CALENDAR_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY=
#
# CALENDAR_ENCRYPTION_KEY encrypts Google / Microsoft OAuth access and refresh
# tokens (server/services/calendarService.js). Optional — falls back to
# TOKEN_ENCRYPTION_KEY. Any length. With neither key set, connecting a calendar
# and every sync fail closed with "Calendar encryption key is not configured".
CALENDAR_ENCRYPTION_KEY=
#
# Changing either key leaves tokens already in MongoDB undecryptable; affected
# users have to reconnect the integration.

# Issue #1335 — client-side meeting transcript E2EE (ciphertext storage)
# When true, clients may POST encrypted transcripts; AI summarization is skipped
# for encrypted meetings because the server has no plaintext.
E2EE_ENABLED=false
